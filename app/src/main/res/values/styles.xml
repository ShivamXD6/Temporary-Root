<resources>
    <!-- Text sizes mirror the Material3 roles the old theme used. -->
    <style name="TextAppearance.TemporaryRoot" parent="android:TextAppearance" />
    <style name="TextAppearance.TemporaryRoot.TitleLarge">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.HeadlineSmall">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.BodyMedium">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.TemporaryRoot.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="Btn.Filled">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    <style name="Btn.Outlined">
        <item name="android:background">@drawable/bg_btn_outlined</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Btn.Tonal">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/on_secondary_container</item>
    </style>
    <style name="Btn.Text">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>
